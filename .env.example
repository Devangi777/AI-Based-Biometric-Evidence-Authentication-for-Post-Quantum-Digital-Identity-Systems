# ---------------------------------------------------------------------------
# PQ-Biometric-Auth configuration
# Copy this file to .env and adjust as needed. All values here have sane
# defaults baked into the code (see server/config.py) so the app runs even
# if .env is missing - this file documents every tunable.
# ---------------------------------------------------------------------------

# --- PQC algorithm selection (Section 5) ---
# NIST Level 3 (recommended default: good security/performance balance)
KEM_ALG=ML-KEM-768
SIG_ALG=ML-DSA-65

# NIST Level 5 alternative - uncomment to measure the heavier overhead
# KEM_ALG=ML-KEM-1024
# SIG_ALG=ML-DSA-87

# Enable the classical (RSA-3072 / ECDSA-P256) code path for side-by-side
# overhead comparison in evaluation/benchmark.py
ENABLE_CLASSICAL_BASELINE=true

# --- Session binding / freshness (Section 7) ---
FRESHNESS_WINDOW_SECONDS=30
NONCE_BYTES=32

# --- Detection thresholds (Section 6.6, fusion) ---
# Per-module ACCEPT threshold (score >= threshold => "genuine" for that module)
THRESHOLD_PRESENTATION_ATTACK=0.5
THRESHOLD_MORPH=0.5
THRESHOLD_DEEPFAKE=0.5
THRESHOLD_REPLAY=0.5
THRESHOLD_INJECTION=0.5

# Fusion weights (must sum to 1.0; weighted average of the 5 module scores)
WEIGHT_PRESENTATION_ATTACK=0.25
WEIGHT_MORPH=0.20
WEIGHT_DEEPFAKE=0.25
WEIGHT_REPLAY=0.15
WEIGHT_INJECTION=0.15

# Final fused score threshold for ACCEPT
FUSION_ACCEPT_THRESHOLD=0.6

# --- Detection model mode ---
# "pretrained" tries to load real checkpoints (see detection/README-models.md);
# "mock" uses deterministic heuristic stand-ins - used automatically as a
# fallback if a checkpoint fails to load, can also be forced for CI/offline dev.
DETECTION_MODE=pretrained
DETECTOR_DEVICE=cpu

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Replay detector store ---
REPLAY_HASH_WINDOW_SECONDS=86400

# --- Client demo (Streamlit, runs natively on Windows) ---
API_BASE_URL=http://localhost:8000
